NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_assistant?schema=public

# Telegram Bot API
# Get this token from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional secret token for Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=

# Optional: only allow known Telegram user IDs in MVP1.
# Leave empty to allow every Telegram sender.
ALLOWED_TELEGRAM_IDS=
