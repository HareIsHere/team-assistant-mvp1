NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_assistant?schema=public

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# Optional: only allow known users in MVP1. Leave empty to auto-register every WhatsApp sender.
ALLOWED_WHATSAPP_IDS=
